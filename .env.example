# ─── MAJBURIY (REQUIRED) ───────────────────────────────
# @BotFather dan olingan bot tokeni
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Admin(lar) Telegram ID. Bir nechta bo'lsa vergul bilan: 111,222,333
ADMIN_IDS=123456789

# To'lovlarni avtomatik aniqlash uchun admin/kvitansiya kanali ID (-100... ko'rinishida)
ADMIN_CHANNEL=-1001234567890

# my.telegram.org dan olingan API ma'lumotlari (Telethon uchun)
API_ID=1234567
API_HASH=your_api_hash_here

# Mini App ochiladigan tashqi domen (Railway domeni yoki o'zingizniki)
WEB_HOST=https://your-railway-domain.railway.app

# ─── IXTIYORIY (OPTIONAL) ───────────────────────────────
# Boshlang'ich to'lov kartasi (admin panelдан ham qo'shish mumkin)
PAYMENT_CARD=8600123456789012

# WEB_HOST bilan bir xil; agar alohida URL kerak bo'lsa shu yerda beriladi
# WEB_URL=https://your-railway-domain.railway.app

# SQLite baza fayli manzili (Railway'da /app/data/ volume tavsiya etiladi)
# DB_PATH=/app/data/usernamechi.db

# Server porti (Railway o'zi beradi; lokalda 8080 default)
# PORT=8080

# ─── AI USERNAME GENERATSIYASI (OPTIONAL) ──────────────
# Tekin Groq / Gemini / OpenRouter API kaliti. Bo'sh bo'lsa oddiy generator ishlaydi.
# LLM_API_KEY=
# LLM_MODEL=openai/gpt-oss-120b
# LLM_API_URL=https://api.groq.com/openai/v1/chat/completions

# ─── STEALTH (OPTIONAL) ─────────────────────────────────
# Doimiy ushlab turiladigan Telethon session string(lar), vergul bilan ajratilgan
# STEALTH_SESSIONS=
